# =========================================================
# AgriBridge Backend Production Environment Variables
# =========================================================

# Server Port (Render sets this dynamically via process.env.PORT)
PORT=5000

# Environment Mode: 'production' | 'development' | 'test'
NODE_ENV=production

# Database Connection Strings (Neon PostgreSQL for Production)
# DATABASE_URL: Pooled connection string with SSL (pgbouncer, port 6543)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: Direct non-pooled connection string (port 5432) for running migrations
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Local SQLite fallback for instant zero-dependency development:
# DATABASE_URL="file:./dev.db"

# Authentication & Security
# Strong, cryptographically secure JWT secret key (minimum 32 random characters in production)
JWT_SECRET=agribridge_super_secure_jwt_secret_key_2026_prod_replace_me
JWT_EXPIRES_IN=7d

# CORS Allowed Frontend Origin(s)
# Comma-separated list of authorized domains (e.g. Vercel deployment URL)
FRONTEND_URL=https://your-agribridge-app.vercel.app

# Optional AI Integration (Google Gemini API key)
# Leave blank to seamlessly use deterministic grounded calculation engine
GEMINI_API_KEY=

# Payment Provider Integration
# Use 'MOCK' for safe zero-cost simulated transactions
PAYMENT_PROVIDER=MOCK
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Seeding & Admin Bootstrap
# Set to 'false' in production to prevent seeding demo users/orders
SEED_DEMO_DATA=false
# Optional one-time admin bootstrap credentials (used by prisma/seed.ts)
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
BOOTSTRAP_ADMIN_PASSWORD=YourStrongSecureAdminPassword123!
