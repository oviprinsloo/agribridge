# =========================================================
# AgriBridge Frontend Production Environment Variables
# =========================================================
# Set this to your deployed Render backend API URL (e.g. https://agribridge-backend.onrender.com/api)
# In local development, leave blank to use the Vite proxy defined in vite.config.ts
VITE_API_BASE_URL=https://your-backend-service.onrender.com/api
